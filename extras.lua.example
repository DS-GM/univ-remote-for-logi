-- =====================================================================
--  extras.lua.example
--
--  Copy to ~/.hammerspoon/extras.lua and edit PEER below.
--
--  Both variants of this project load ~/.hammerspoon/extras.lua after the
--  mouse remap is running. The file is optional and switch.sh never
--  touches it, so anything here survives switching variants.
--
--  Three recipes for a two-Mac Universal Control desk where the keyboard
--  and mouse live on ONE Mac:
--
--    1. a lock key that sleeps the displays on BOTH Macs
--    2. Caps Lock language switching that reaches the OTHER Mac
--    3. Caps Lock that can never lock uppercase
--
--  1 and 2 need SSH from this Mac to the peer: Remote Login enabled on
--  the peer, key-only auth, and a Host alias in ~/.ssh/config. Recipe 2
--  also needs Hammerspoon running on the peer.
-- =====================================================================

-- A Host alias in ~/.ssh/config, e.g.
--     Host peer-mac
--         HostName 100.x.y.z          # Tailscale address works well here
--         User youruser
--         IdentityFile ~/.ssh/id_ed25519
-- Set PEER to nil to make everything below local-only.
local PEER = "peer-mac"

-- Set true to let Caps Lock behave normally, i.e. long press really locks
-- uppercase. See recipe 3 for why the default here is false.
local ALLOW_CAPS_LOCK = false

-- ControlMaster keeps ONE multiplexed SSH connection alive, which is what
-- makes recipe 2 usable at all: measured 296 ms for a cold SSH versus 80
-- to 90 ms over an established master, remote command included. Most of a
-- cold SSH is TCP plus crypto negotiation, not data.
--
-- The control socket path must stay SHORT. A Unix domain socket path caps
-- out near 104 characters and a longer one just fails, so keep it in /tmp
-- rather than somewhere nested.
local MUX = "/tmp/cm-" .. tostring(PEER)

local function peerArgs(remoteCmd)
    return { "-o", "BatchMode=yes",
             "-o", "ConnectTimeout=3",
             "-o", "ControlMaster=auto",
             "-o", "ControlPath=" .. MUX,
             "-o", "ControlPersist=600",
             PEER, remoteCmd }
end

-- IMPORTANT, and easy to get wrong. A CGEventTap callback is SYNCHRONOUS:
-- WindowServer holds the event until the callback returns. Forking a
-- process in there costs 1.06 ms median and 3.05 ms max (measured), and
-- that delay lands on the very key event that triggered the callback.
-- For Caps Lock it skews the press duration macOS uses to choose between
-- switching language and locking uppercase, because the delay hits
-- key-down while key-up goes through untouched. Repeated presses pile up
-- processes and make it worse.
--
-- Scheduling instead costs 0.006 ms, 175x less, and moves the fork to the
-- next event-loop pass. Every peer call below goes through here, so no
-- event ever waits on a fork.
local function peerAsync(remoteCmd)
    if not PEER then return end
    hs.timer.doAfter(0, function()
        hs.task.new("/usr/bin/ssh", nil, peerArgs(remoteCmd)):start()
    end)
end


-- ---------------------------------------------------------------------
--  Recipe 1: lock key → displays off on BOTH Macs
-- ---------------------------------------------------------------------
-- Display sleep only, via `pmset displaysleepnow`. Both Macs stay awake,
-- so Universal Control, Tailscale and SSH keep running. Waking is one
-- keypress on either machine.
--
-- Which combo to bind depends on your keyboard, and the answer is often
-- surprising. Two measured examples:
--
--   Logitech MX Keys (Mac layout)  emits plain ⌃⌘Q, which IS macOS's own
--                                  lock-screen shortcut. Binding a hotkey
--                                  to it preempts the system lock.
--
--   8BitDo Retro 108 (PC layout)   emits Win+L, the Windows lock
--                                  shortcut, i.e. Left GUI + L on the
--                                  wire. If that Mac also has Option and
--                                  Command swapped for the keyboard under
--                                  System Settings > Keyboard > Keyboard
--                                  Shortcuts > Modifier Keys, Left GUI
--                                  arrives as Option, so the event lands
--                                  as ⌥L rather than ⌘L.
--
-- Probe your own key before binding: set PROBE_MODE in init.lua, or use a
-- small eventtap that prints getKeyCode() and getFlags().
--
-- Note that a CGEvent carries no device id, so a hotkey bound here fires
-- for that combo from ANY keyboard on the Mac. Pick a combo you never
-- type. If you need per-device behaviour, an eventtap can additionally
-- check `keyboardEventKeyboardType`.

local function displaysOff()
    peerAsync("pmset displaysleepnow")
    hs.execute("/usr/bin/pmset displaysleepnow")
end

-- Kept in a global table so the bindings are not garbage collected.
displayOffHotkeys = {
    hs.hotkey.bind({ "ctrl", "cmd" }, "q", displaysOff),  -- Mac-layout lock key
    hs.hotkey.bind({ "alt"         }, "l", displaysOff),  -- PC-layout lock key
}


-- ---------------------------------------------------------------------
--  Recipe 2: Caps Lock language switch across Universal Control
-- ---------------------------------------------------------------------
-- The problem: with Universal Control focus on the peer, pressing Caps
-- Lock does nothing there. For CJK input methods that is the language
-- toggle, so the peer becomes unusable for anything but ASCII.
--
-- Universal Control does not forward Caps Lock. Measured with probes
-- running on BOTH Macs at once: 13 presses produced 13 events on the
-- sending Mac and ZERO on the receiving one. WindowServer does the UC
-- forwarding and simply omits this key.
--
-- Two things that look like fixes and are not:
--
--   * Turning off the OS's own Caps-Lock-switches-language on the sender
--     and reimplementing short versus long press here. That setting is
--     consumed in HIToolbox, which sits ABOVE WindowServer, so what the
--     sender does with the key cannot change what WindowServer forwards.
--     Synthesising a substitute keystroke does not help either: it passes
--     through the same WindowServer filter.
--
--   * Mirroring the input source with hs.keycodes.inputSourceChanged.
--     While UC focus is on the peer, the sender's currentSourceID does
--     not move at all. The tap sees the event but HIToolbox has no local
--     focused input context to act on, so there is no state change to
--     mirror.
--
-- So leave the UC link alone and go around it: ask the peer over SSH to
-- switch its input source directly.
--
-- DO NOT post a synthetic Caps Lock on the peer instead. That was the
-- first version of this recipe and it is a trap. Two back-to-back
-- `newSystemKeyEvent(...):post()` calls make a press with NO duration,
-- and macOS chooses between "switch language" and "lock uppercase" by how
-- long the key is held, so a zero-length press can land on either side.
-- In practice the peer sometimes switched language and sometimes engaged
-- uppercase. And there is no way back: since UC does not forward Caps
-- Lock, once uppercase is locked on the peer no key you press can release
-- it. The relay can set that state but not clear it.
--
-- Setting the source directly loses nothing. The peer's own short-versus-
-- long logic is unreachable by definition, because a real Caps Lock never
-- arrives there. Measured deterministic: 4 of 4 clean alternations with
-- the peer's capslock flag staying false throughout.
--
-- Find your own identifiers by running this on the peer:
--     hs -c 'return hs.keycodes.currentSourceID()'
-- once per state.
local KO_SOURCE = "com.apple.inputmethod.Korean.2SetKorean"
local EN_SOURCE = "com.apple.keylayout.ABC"

-- Single-quoted for the remote shell, so the Lua inside must use double
-- quotes only. The `< /dev/null` is required: the hs CLI blocks forever
-- waiting on stdin otherwise. The full path is required too, because the
-- CLI is not on the PATH of a non-interactive SSH session.
local REMOTE_TOGGLE = ([[/opt/homebrew/bin/hs -q -n -t 3 -c ']]
    .. [[local KO,EN="%s","%s"; ]]
    .. [[local id=hs.keycodes.currentSourceID(); ]]
    .. [[hs.keycodes.currentSourceID(id:match("Korean") and EN or KO)]]
    .. [[' < /dev/null]]):format(KO_SOURCE, EN_SOURCE)

-- This tap NEVER swallows the event (always returns false), so the
-- sender's own native Caps Lock handling is untouched. Only the peer is
-- driven.
--
-- Do not extend this to the local Mac as well. It was tried: swallow the
-- event so macOS cannot also toggle, then set this Mac's source here too.
-- The switching worked perfectly, 53 of 53 presses, zero mismatches. It
-- was still reverted, because setting the source out of band does not
-- coordinate with the input method's COMPOSITION BUFFER. A half-composed
-- Korean syllable stays pending and commits after the characters typed
-- next, so "ㅁㄴㅇ" + Caps Lock + "asd" came out "ㅁㄴasdㅇ" every time.
-- Doing the switch synchronously inside this callback did not help: the
-- delay is hs.keycodes.currentSourceID() itself, 32 ms median inline
-- against 33 ms deferred, and the input method commits on its own
-- schedule afterwards regardless. macOS's native path avoids it because
-- HIToolbox tells the input method to commit as part of the switch. Its
-- reliability is worse, but a missed switch beats reordered characters.
capsBridgeTap = hs.eventtap.new({ hs.eventtap.event.types.systemDefined }, function(e)
    -- Caps Lock is not an ordinary keycode; it arrives as a
    -- system-defined event, and systemKey() resolves it by name.
    local sk = e:systemKey()
    if not (sk and sk.key == "CAPS_LOCK" and sk.down) then return false end
    peerAsync(REMOTE_TOGGLE)
    return false
end)

if PEER then capsBridgeTap:start() end


-- ---------------------------------------------------------------------
--  Recipe 3: Caps Lock never locks uppercase
-- ---------------------------------------------------------------------
-- If Caps Lock is only ever wanted as a language key, remove the locked
-- state instead of trying to make misfires rarer. Being stuck in
-- uppercase with no reliable way out is much worse than the misfire.
--
-- This cannot interfere with the language switch: a short press for the
-- switch never sets the capslock flag at all.
--
-- TWO mechanisms, deliberately. The event tap is the fast path, reacting
-- a millisecond or two after the lock engages. The timer is the actual
-- guarantee, because not every route into the locked state emits a
-- flagsChanged: hs.hid.capslock.set() writes the IOKit state directly and
-- produces no event whatsoever, so a tap-only guard silently misses it.
-- get() costs 0.0865 ms, so polling at 0.15 s is about 0.06 percent of
-- one core.
--
-- The tap defers its clear rather than doing it inline, because set()
-- itself produces a flagsChanged and would re-enter this callback, and
-- because the callback has to stay fast for the same reason peerAsync
-- exists.
--
-- Tradeoff: a long press still shows uppercase for up to 0.15 s before it
-- is dropped, so a stray capital can slip through if you type instantly.
-- Mapping Caps Lock to "No Action" in Modifier Keys prevents the lock
-- outright, but that kills the language switch too.
--
-- Set ALLOW_CAPS_LOCK = true at the top for normal behaviour.

local function dropCapsLock()
    if hs.hid.capslock.get() then hs.hid.capslock.set(false) end
end

capsLockGuardTap = hs.eventtap.new({ hs.eventtap.event.types.flagsChanged }, function(e)
    if e:getKeyCode() == 57 then                  -- 57 = Caps Lock
        hs.timer.doAfter(0, dropCapsLock)
    end
    return false
end)

capsLockGuardTimer = hs.timer.new(0.15, dropCapsLock)

if not ALLOW_CAPS_LOCK then
    capsLockGuardTap:start()
    capsLockGuardTimer:start()
    dropCapsLock()          -- also covers a lock already on at load time
end


print(("extras: displays-off hotkeys | caps language bridge %s | caps-lock guard %s")
      :format(PEER and ("-> " .. PEER) or "OFF",
              ALLOW_CAPS_LOCK and "OFF" or "ON"))
