-- =====================================================================
--  extras.lua.example
--
--  Copy to ~/.hammerspoon/extras.lua and edit PEER below.
--
--  Both variants of this project load ~/.hammerspoon/extras.lua after the
--  mouse remap is running. The file is optional and switch.sh never
--  touches it, so anything here survives switching variants.
--
--  Three recipes for a two-Mac Universal Control desk where the keyboard
--  and mouse live on ONE Mac:
--
--    1. a lock key that sleeps the displays on BOTH Macs
--    2. Caps Lock language switching that reaches the OTHER Mac
--    3. Caps Lock that can never lock uppercase
--
--  1 and 2 need SSH from this Mac to the peer: Remote Login enabled on
--  the peer, key-only auth, and a Host alias in ~/.ssh/config. Recipe 2
--  also needs Hammerspoon running on the peer.
-- =====================================================================

-- A Host alias in ~/.ssh/config, e.g.
--     Host peer-mac
--         HostName 100.x.y.z          # a Tailscale address works well
--         User youruser
--         IdentityFile ~/.ssh/id_ed25519
-- Set PEER to nil to make everything below local-only.
local PEER = "peer-mac"

-- Caps Lock behaviour, see section 2.
--   LOCAL_CAPS_TOGGLE  true  = Hammerspoon owns Caps Lock on THIS Mac and
--                              switches the input source itself. Tried and
--                              abandoned, see the long note in section 2.
--                      false = leave this Mac's Caps Lock to macOS and
--                              only drive the peer. Current choice.
--   ALLOW_CAPS_LOCK    true  = let an uppercase lock stand.
--                      false = drop it the moment it engages.
local LOCAL_CAPS_TOGGLE = false
local ALLOW_CAPS_LOCK   = false

-- Reused by every peer command here. ControlMaster keeps one multiplexed
-- connection alive: measured 296 ms per cold SSH versus 80 to 90 ms over
-- the master, remote command included.
-- The socket path has to stay SHORT. A Unix domain socket path is capped
-- around 104 chars and a longer one fails, so this lives in /tmp rather
-- than anywhere nested.
local MUX = "/tmp/cm-" .. PEER

local function peerArgs(remoteCmd)
    return { "-o", "BatchMode=yes",
             "-o", "ConnectTimeout=3",
             "-o", "ControlMaster=auto",
             "-o", "ControlPath=" .. MUX,
             "-o", "ControlPersist=600",
             PEER, remoteCmd }
end

-- A CGEventTap callback is SYNCHRONOUS: WindowServer holds the event until
-- the callback returns, so anything slow in there delays the key that
-- triggered it. Measured costs of things one might inline:
--
--   hs.task.new():start()                    1.06 ms median, 3.05 ms max
--   hs.keycodes.currentSourceID(target)     31.13 ms median, 65.83 ms max
--
-- hs.timer.doAfter(0, ...) costs 0.006 ms and runs the work on the next
-- event-loop pass.
--
-- Be clear about what deferring buys, because it is easy to overclaim. It
-- keeps the EVENT PATH fast. It does NOT make the deferred work itself any
-- faster. Running the input-source switch inline instead measured 32 ms
-- median versus 33 ms deferred, which is exactly why the synchronous
-- experiment described in section 2 changed nothing. Defer to protect the
-- event stream, not to speed anything up.
local function soon(fn) hs.timer.doAfter(0, fn) end

local function peerAsync(remoteCmd)
    if not PEER then return end
    soon(function()
        hs.task.new("/usr/bin/ssh", nil, peerArgs(remoteCmd)):start()
    end)
end


-- ---------------------------------------------------------------------
--  1. Lock keys → displays off on BOTH Macs
-- ---------------------------------------------------------------------
-- Display sleep only: both Macs stay awake, so Universal Control,
-- Tailscale and SSH keep running.
--
-- Two keyboards, two different keys, same action:
--
--   MX Keys (Mac layout)    emits ⌃⌘Q, which IS macOS's own lock-screen
--                           shortcut. Registering a hotkey on it
--                           preempts the system lock.
--                           (verified 2026-08-19)
--
--   8BitDo Retro 108 (PC)   emits Win+L, the Windows lock shortcut.
--                           On the wire that is Left GUI (0xE3) + L.
--                           If that Mac also has Option and Command
--                           swapped for the device under System
--                           Settings > Keyboard > Keyboard Shortcuts >
--                           Modifier Keys, Left GUI arrives as Option
--                           and the event lands as ⌥L: keycode 37 with
--                           the alt flag, no other modifier.
--                           (verified 2026-08-20)
--
-- CAREFUL, two coupled facts about the ⌥L binding:
--
--   1. It depends on that per-device modifier swap. Undo the swap and
--      the same key starts arriving as ⌘L, which would break this
--      binding AND shadow "focus the address bar" in every browser.
--   2. A CGEvent carries no device identifier, so this fires for ⌥L
--      from ANY keyboard on this Mac, not just the 8BitDo. ⌥L types
--      "¬" and is otherwise unused, so the collision is accepted. If it
--      ever bites, replace the hotkey with an eventtap that also checks
--      keyboardEventKeyboardType (the 8BitDo reports 40).
--
-- Probe your own key before binding, with a small eventtap that prints
-- getKeyCode() and getFlags(). Whatever you write, it MUST return false
-- on every path and its body belongs inside pcall. A probe whose callback
-- raises a Lua error consumes the event instead of passing it on, which
-- kills the keyboard outright and leaves no visible cause. That happened
-- here on 2026-08-25: a probe left loaded from an earlier session had a
-- bad string.format specifier, every keystroke hit the error, and the Mac
-- accepted input only in password fields, where secure input disables all
-- event taps. Reloading Hammerspoon was the whole fix. Give any probe a
-- self-stopping timer so it cannot outlive the session that started it.

local function displaysOff()
    peerAsync("pmset displaysleepnow")
    hs.execute("/usr/bin/pmset displaysleepnow")
end

-- Kept in a global table so the bindings are not garbage collected.
displayOffHotkeys = {
    hs.hotkey.bind({ "ctrl", "cmd" }, "q", displaysOff),  -- MX Keys lock key
    hs.hotkey.bind({ "alt"         }, "l", displaysOff),  -- 8BitDo lock key
}


-- ---------------------------------------------------------------------
--  2. Caps Lock as a deterministic language key, here and on the peer
-- ---------------------------------------------------------------------
-- Two separate problems, one answer.
--
-- SCOPE FIRST: this is a Universal Control mechanism and nothing else.
-- Over Screen Sharing the keyboard never reaches this Mac, so none of it
-- runs. Measured 2026-08-25 across a Screen Sharing session: the peer's
-- input source never moved and the SSH control socket was never created.
-- A Caps Lock problem seen over Screen Sharing is a different bug with a
-- different cause, and changing anything here will not touch it.
--
-- ON THE PEER: with Universal Control focus there, Caps Lock does nothing
-- at all. Measured 2026-08-20 with probes on BOTH Macs at once: 13 presses
-- produced 13 events here and ZERO on the peer. WindowServer does the UC
-- forwarding and omits this key.
--
-- Turning off macOS's own Caps-Lock-switches-language here would not help,
-- because that setting is consumed in HIToolbox, ABOVE WindowServer, so
-- what this Mac does with the key cannot change what gets forwarded.
-- Synthesising a substitute keystroke fails for the same reason. And
-- mirroring hs.keycodes.inputSourceChanged cannot work either: while UC
-- focus is on the peer, this Mac's currentSourceID does not move at all,
-- so there is no local state change to mirror.
--
-- ON THIS MAC the same treatment WAS TRIED AND ABANDONED (2026-08-21).
-- Worth recording, because the mechanism looked perfect and still had to
-- be reverted.
--
-- macOS's own Caps Lock language switch here is unreliable: in daily use
-- it sometimes switched, sometimes engaged uppercase, sometimes did
-- nothing. It picks switch-versus-lock by hold time and that judgement
-- keeps misfiring. So Hammerspoon took the key over locally too, setting
-- the source itself and swallowing the event so macOS could not
-- double-toggle. That part worked flawlessly: 53 of 53 presses switched
-- correctly, zero mismatches, tap never disabled, across two runs.
--
-- It still had to go, because switching the source OUT OF BAND does not
-- coordinate with the input method's COMPOSITION BUFFER. A half-composed
-- Korean syllable stays pending and gets committed after the characters
-- typed next, so "ㅁㄴㅇ" + Caps Lock + "asd" came out as "ㅁㄴasdㅇ",
-- consistently. Reads as a failed switch; it is actually a reordering.
--
-- Making the switch synchronous inside the tap callback did not help, and
-- the numbers say why. The delay is not deferral overhead, it is the
-- hs.keycodes.currentSourceID() call itself: 33 ms median deferred versus
-- 32 ms median inline, 47 ms worst case. And the input method commits on
-- its own schedule afterwards, which blocking an event tap cannot
-- reorder.
--
-- macOS's native path avoids all of it because HIToolbox tells the input
-- method to commit as part of the switch. Its reliability is worse, but
-- the trade is better: an occasional missed switch beats characters
-- landing in the wrong order. Flip LOCAL_CAPS_TOGGLE to retry the
-- takeover if a future macOS changes any of this.
--
-- NOTE the two Macs use DIFFERENT English source ids. Find yours with
--     hs -c 'return hs.keycodes.currentSourceID()'
-- once in each state, on each machine.
local LOCAL_KO  = "com.apple.inputmethod.Korean.2SetKorean"
local LOCAL_EN  = "com.apple.keylayout.US"    -- this Mac
local REMOTE_KO = "com.apple.inputmethod.Korean.2SetKorean"
local REMOTE_EN = "com.apple.keylayout.ABC"   -- the peer

local function toggleLocalSource()
    local id = hs.keycodes.currentSourceID()
    hs.keycodes.currentSourceID(id:match("Korean") and LOCAL_EN or LOCAL_KO)
end

-- Single-quoted for the remote shell, so the Lua inside must use double
-- quotes only. The `< /dev/null` is required: the hs CLI blocks forever
-- waiting on stdin otherwise. The full path is required too, because the
-- CLI is not on the PATH of a non-interactive SSH session.
local REMOTE_TOGGLE = ([[/opt/homebrew/bin/hs -q -n -t 3 -c ']]
    .. [[local KO,EN="%s","%s"; ]]
    .. [[local id=hs.keycodes.currentSourceID(); ]]
    .. [[hs.keycodes.currentSourceID(id:match("Korean") and EN or KO)]]
    .. [[' < /dev/null]]):format(REMOTE_KO, REMOTE_EN)

-- Do NOT post a synthetic Caps Lock at the peer instead of setting its
-- source. That was the first version and it is a trap: two back-to-back
-- newSystemKeyEvent posts make a press with NO duration, and macOS picks
-- switch-versus-lock by hold time, so it landed on either side at random.
-- The failure was not symmetric either. Since UC never forwards Caps
-- Lock, once uppercase locked on the peer there was no key left to release
-- it: the relay could set that state and not clear it.

-- Caps Lock arrives as a system-defined event rather than an ordinary
-- keycode, and systemKey() resolves it by name.
--
-- The return value matters. With LOCAL_CAPS_TOGGLE the event is SWALLOWED,
-- for one specific reason: if macOS also handled the key we would get two
-- toggles per press and end up back where we started. Swallowing makes
-- Hammerspoon the single authority. Both down and up are swallowed so no
-- half-press reaches anything downstream.
capsBridgeTap = hs.eventtap.new({ hs.eventtap.event.types.systemDefined }, function(e)
    local sk = e:systemKey()
    if not (sk and sk.key == "CAPS_LOCK") then return false end
    if sk.down then
        peerAsync(REMOTE_TOGGLE)
        if LOCAL_CAPS_TOGGLE then soon(toggleLocalSource) end
    end
    return LOCAL_CAPS_TOGGLE
end)
capsBridgeTap:start()

-- Uppercase lock guard.
--
-- Symptom that made this necessary: once uppercase engaged, the long press
-- that should release it did not take. Having no way out is far worse than
-- the occasional misfire, so the state is removed rather than made rarer.
--
-- TWO mechanisms, deliberately. The tap is the fast path, reacting a
-- millisecond or two after the lock engages. The timer is the actual
-- guarantee, because not every route into the locked state emits a
-- flagsChanged: hs.hid.capslock.set() writes IOKit state directly and
-- produces no event whatsoever, which is exactly how a tap-only version of
-- this guard silently failed in testing. get() costs 0.0865 ms, so polling
-- at 0.15 s is about 0.06 percent of one core.
--
-- The tap also swallows when LOCAL_CAPS_TOGGLE is on, so no app ever sees
-- the capslock modifier flag move.
--
-- Tradeoff: a long press still shows uppercase for up to 0.15 s before it
-- is dropped, so a stray capital slips through if you type instantly.
--
-- DO NOT reach for the obvious native shortcut here. Mapping Caps Lock to
-- "No Action" under System Settings > Keyboard > Keyboard Shortcuts >
-- Modifier Keys does prevent the lock outright and would retire both
-- mechanisms below, but it kills the language switch in section 2 as
-- well. Guard and bridge are coupled: you get the language key or the
-- native lock-proofing, not both. That result was recorded when this file
-- was first written and the reason was not captured with it, so if you
-- want to revisit it, measure whether the system-defined CAPS_LOCK event
-- still fires with the mapping applied before you change anything.
--
-- Set ALLOW_CAPS_LOCK = true at the top for normal behaviour.
local function dropCapsLock()
    if hs.hid.capslock.get() then hs.hid.capslock.set(false) end
end

capsLockGuardTap = hs.eventtap.new({ hs.eventtap.event.types.flagsChanged }, function(e)
    if e:getKeyCode() ~= 57 then return false end     -- 57 = Caps Lock
    if not ALLOW_CAPS_LOCK then soon(dropCapsLock) end
    return LOCAL_CAPS_TOGGLE
end)
capsLockGuardTap:start()

capsLockGuardTimer = hs.timer.new(0.15, dropCapsLock)
if not ALLOW_CAPS_LOCK then
    capsLockGuardTimer:start()
    dropCapsLock()          -- also covers a lock already on at load time
end


print(("extras: displays-off ⌃⌘Q + ⌥L | caps: local=%s peer=%s guard=%s")
      :format(LOCAL_CAPS_TOGGLE and "ON" or "OFF",
              PEER and PEER or "OFF",
              ALLOW_CAPS_LOCK and "OFF" or "ON"))
